# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# background tooling scratch dirs (claude-flow/ruflo hooks, graphify sync)
.claude-flow/
graphify-out/

# typescript
*.tsbuildinfo
next-env.d.ts
.bucla/
.swarm/
ruvector.db

# local-only push-drain secret (do not commit)
supabase/seeds/local_secrets.sql

# Local operational-server master creds (never commit)
scripts/.dev-local.env
.osrm/
tools/simulator/.venv/
tools/simulator/__pycache__/

# agent worktrees (Workflow isolation: worktree)
.claude/worktrees/
