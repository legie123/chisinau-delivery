NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-start-output

# Server-only — never expose to the client, never commit a real value.
# Used for admin actions (inviting couriers/restaurant partners).
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-supabase-start-output
